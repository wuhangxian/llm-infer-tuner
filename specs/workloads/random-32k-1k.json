{
  "workload_id": "random-32k-1k",
  "type": "serving_benchmark",
  "modality": "text",

  "dataset": {
    "name": "random",
    "path": "ShareGPT_V3_unfiltered_cleaned_split.json",
    "random_range_ratio": 1.0
  },

  "input_tokens": {
    "distribution": "fixed",
    "value": 32768
  },

  "output_tokens": {
    "distribution": "fixed",
    "value": 1024
  },

  "traffic": {
    "mode": "max_concurrency",
    "values": [1, 2, 4, 8, 16, 32],
    "num_prompts_multiplier": 4
  },

  "request": {
    "stream": true
  },

  "notes": "随机生成约 32K 输入 token 和 1K 输出 token；每个并发档位的请求数为并发度的 4 倍。"
}
