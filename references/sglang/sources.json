{
  "schema_version": 1,
  "engine": "sglang",
  "sources": [
    {
      "source_id": "sglang-server-arguments",
      "url": "https://docs.sglang.io/docs/advanced_features/server_arguments",
      "authority": "official",
      "purpose": "了解服务启动参数的含义、默认值和适用场景"
    },
    {
      "source_id": "sglang-repository",
      "url": "https://github.com/sgl-project/sglang",
      "authority": "official",
      "purpose": "在参数行为与文档不一致时，核对目标版本源码"
    },
    {
      "source_id": "ai-infra-auto-driven-skills-benchmark",
      "url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/tree/main/skills/llm-serving-auto-benchmark",
      "authority": "secondary",
      "purpose": "参考 base_server_flags、search_space 和有界候选生成方式"
    }
  ],
  "runtime_validation": {
    "source_of_truth": "target_environment_help",
    "required_commands": [
      "python -m sglang.launch_server --help",
      "python -m sglang.bench_serving --help"
    ],
    "rule": "网页文档用于解释参数；目标镜像中的 --help 用于确认参数名、别名和当前可用性。"
  },
  "refresh_policy": {
    "copy_full_documents": false,
    "refresh_when": [
      "SGLang 镜像版本变化",
      "目标环境的 --help 与既有记录不一致",
      "生成候选时发现参数不存在或行为变化"
    ]
  }
}
